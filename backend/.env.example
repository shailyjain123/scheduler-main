# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Rails runtime
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5
PORT=3000
WEB_CONCURRENCY=0
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=1
PIDFILE=tmp/pids/server.pid
CI=

# Security / sessions
SECRET_KEY_BASE=replace_with_secure_random_value
JWT_SECRET_KEY=replace_with_secure_random_value
SESSION_SECRET=replace_with_secure_random_value
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_secure_random_value
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_secure_random_value
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_secure_random_value

# OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Database / cache
DATABASE_URL=
REDIS_URL=
BACKEND_DATABASE_PASSWORD=

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=

# Email / notifications
# AMP for Email (Gmail in-email RSVP): register MAILER_FROM_EMAIL domain at
# https://developers.google.com/gmail/amppay/promo/registration — test at https://amp.gmail.dev/
AMP_EMAIL_ENABLED=true
API_PUBLIC_URL=
MAILER_FROM_EMAIL=no-reply@example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Verifalia Email Validation
VERIFALIA_USERNAME=account_email
VERIFALIA_PASSWORD=account_password
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
