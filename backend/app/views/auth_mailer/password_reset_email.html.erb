<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Reset Your Password | Schedulr</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fb; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8f9fb; padding: 40px 20px;">
        <tr>
            <td align="center">
                <!-- Main Container -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto;">
                    
                    <!-- Header / Logo -->
                    <tr>
                        <td align="center" style="padding-bottom: 40px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="font-size: 28px; line-height: 1; vertical-align: middle;">🗓️</td>
                                    <td style="font-size: 24px; font-weight: 800; color: #191c1e; padding-left: 8px; font-family: 'Inter', sans-serif; letter-spacing: -0.05em;">Schedulr</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- content card -->
                    <tr>
                        <td style="background-color: #ffffff; border-radius: 12px; padding: 48px; border-top: 4px solid #3649db; box-shadow: 0 16px 48px rgba(17,24,39,0.06);">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <h1 style="margin: 0; font-size: 28px; font-weight: 800; color: #191c1e; tracking: -0.025em; font-family: 'Inter', sans-serif;">Reset your password</h1>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <p style="margin: 0; font-size: 15px; color: #454655; line-height: 1.6; font-family: 'Inter', sans-serif;">
                                            Hi <%= @user.full_name || 'there' %>, we received a request to reset your password for your Schedulr account. Click the button below to set a new one.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 48px;">
                                        <a href="<%= @reset_url %>" style="background-color: #3649db; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 700; font-size: 15px; display: inline-block; box-shadow: 0 4px 12px rgba(54,73,219,0.25);">
                                            Reset Password
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div style="height: 1px; background-color: #edeef0; width: 100%;"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-top: 32px;">
                                        <div style="background-color: #f3f4f6; border-radius: 12px; padding: 24px; text-align: center;">
                                            <p style="margin: 0 0 16px 0; font-size: 13px; color: #757686; font-weight: 600; font-family: 'Inter', sans-serif;">Button not working? Use the link below:</p>
                                            <a href="<%= @reset_url %>" style="background-color: #ffffff; border: 1.5px solid #3649db; color: #3649db; text-decoration: none; padding: 10px 24px; border-radius: 6px; font-weight: 700; font-size: 13px; display: inline-block;">
                                                Copy Reset Link
                                            </a>
                                            <p style="margin: 12px 0 0 0; font-size: 11px; color: #94a3b8; font-family: 'Inter', sans-serif;">(Right-click to copy the link address)</p>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 24px;">
                                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                            <tr>
                                                <td width="32" valign="top" style="font-size: 16px; line-height: 1;">ℹ️</td>
                                                <td style="font-size: 12px; color: #757686; line-height: 1.6; font-family: 'Inter', sans-serif;">
                                                    This link will expire in <%= @expiry_minutes %> minutes. If you didn't request this, you can safely ignore this email.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- visual asset container -->
                    <tr>
                        <td style="padding-top: 32px;">
                            <div style="background-color: #000000; border-radius: 12px; overflow: hidden; position: relative;">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDNSqVJ_47d3OufzGxyvNTx91aKgl2pN0QJ_vvGjAeIb2SD4wMflwjydjQLX5KVrLEnYTbapLfl7s2VfB3nHtbjXVRXqYDfPl4TDmWhtSYWOElh71Gbv7rSw3q3aChIY7KP5ydj9srbRoTDoBY_m-mOWufASgoGhKbpK5gQv7cSwHY27qcczNx0V8-hjoQzh36zkoFFjUA8XkHm3mqnQ1r-IDRrBvp1SdCYhns0POYsjl4fSnws0SMGdHum8Y0COHp4FVznTXt12A" 
                                     alt="Workspace" width="600" style="display: block; width: 100%; height: auto; opacity: 0.6; filter: grayscale(100%);">
                                
                                <div style="position: absolute; bottom: 0; left: 0; right: 0; background-color: rgba(225, 226, 228, 0.9); padding: 20px;">
                                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                        <tr>
                                            <td style="padding-bottom: 4px;">
                                                <span style="font-size: 14px; margin-right: 4px;">✨</span>
                                                <span style="font-size: 11px; font-weight: 800; color: #191c1e; text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Inter', sans-serif;">Intelligent Scheduling</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <p style="margin: 0; font-size: 12px; color: #454655; font-family: 'Inter', sans-serif;">Your calendar is being optimized as you read this.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 48px 0;">
                            <p style="margin: 0 0 16px 0; font-size: 12px; color: #64748b; font-family: 'Inter', sans-serif;">
                                © 2024 Schedulr Inc. All rights reserved.<br/>
                                123 Scheduling Way, San Francisco, CA
                            </p>
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">🌐</td>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">🔒</td>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">✅</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
