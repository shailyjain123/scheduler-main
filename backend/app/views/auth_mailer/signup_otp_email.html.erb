<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Verify your account | Schedulr</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fb; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8f9fb; padding: 40px 20px;">
        <tr>
            <td align="center">
                <!-- Main Container -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto;">
                    
                    <!-- Header / Logo -->
                    <tr>
                        <td align="center" style="padding-bottom: 40px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="font-size: 28px; line-height: 1; vertical-align: middle;">🗓️</td>
                                    <td style="font-size: 24px; font-weight: 800; color: #191c1e; padding-left: 8px; font-family: 'Inter', sans-serif; letter-spacing: -0.05em;">Schedulr</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- content card -->
                    <tr>
                        <td align="center" style="background-color: #ffffff; border-radius: 12px; padding: 48px; border-top: 4px solid #3649db; box-shadow: 0 16px 48px rgba(17,24,39,0.06);">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center" style="padding-bottom: 24px;">
                                        <div style="width: 64px; height: 64px; border-radius: 32px; background-color: #dfe0ff; color: #000a63; display: flex; align-items: center; justify-content: center; font-size: 32px; line-height: 1;">
                                          🔒
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <h1 style="margin: 0; font-size: 28px; font-weight: 800; color: #191c1e; tracking: -0.025em; font-family: 'Inter', sans-serif;">Your verification code</h1>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <p style="margin: 0; font-size: 15px; color: #454655; line-height: 1.6; font-family: 'Inter', sans-serif;">
                                            Hello <%= @user.full_name || 'there' %>, we received a request for a verification code for your Schedulr account. Please enter the code below to continue.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <div style="background-color: #EEF0FF; border: 1.5px solid #5C6EFF; border-radius: 8px; padding: 32px;">
                                          <span style="font-size: 48px; font-weight: 800; color: #3649db; letter-spacing: 0.25em; font-family: 'Courier New', Courier, monospace;"><%= @otp_code %></span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 40px;">
                                        <p style="margin: 0 0 8px 0; font-size: 14px; color: #454655; font-weight: 700; font-family: 'Inter', sans-serif;">
                                           ⏱️ This code expires in <%= @expiry_minutes %> minutes.
                                        </p>
                                        <p style="margin: 0; font-size: 14px; color: #757686; font-family: 'Inter', sans-serif; opacity: 0.8;">
                                            If you did not request this code, you can safely ignore this email.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center">
                                        <% @frontend_url = ENV.fetch('FRONTEND_URL') %>
                                        <a href="<%= "#{@frontend_url}/verify-otp?email=#{CGI.escape(@user.email)}" %>" style="background-color: #3649db; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 700; font-size: 15px; display: inline-block; box-shadow: 0 4px 12px rgba(54,73,219,0.25);">
                                            Verify Account
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 48px 0;">
                            <p style="margin: 0 0 16px 0; font-size: 12px; color: #64748b; font-family: 'Inter', sans-serif;">
                                © 2024 Schedulr Inc. All rights reserved.<br/>
                                123 Scheduling Way, San Francisco, CA
                            </p>
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">🌐</td>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">📋</td>
                                    <td style="font-size: 20px; text-align: center; color: #c5c5d7; padding: 0 8px;">✅</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
