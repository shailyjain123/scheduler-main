<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Verify your booking | Schedulr</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fb; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8f9fb; padding: 40px 20px;">
        <tr>
            <td align="center">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto;">
                    <tr>
                        <td align="center" style="background-color: #ffffff; border-radius: 12px; padding: 48px; border-top: 4px solid #3649db; box-shadow: 0 16px 48px rgba(17,24,39,0.06);">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <h1 style="margin: 0; font-size: 28px; font-weight: 800; color: #191c1e; font-family: 'Inter', sans-serif;">Verify your booking request</h1>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 24px;">
                                        <p style="margin: 0; font-size: 15px; color: #454655; line-height: 1.6; font-family: 'Inter', sans-serif;">
                                            Hi <%= @guest_name.presence || 'there' %>, enter the code below on the booking page to confirm that this email address belongs to you.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <div style="background-color: #EEF0FF; border: 1.5px solid #5C6EFF; border-radius: 8px; padding: 32px;">
                                          <span style="font-size: 48px; font-weight: 800; color: #3649db; letter-spacing: 0.25em; font-family: 'Courier New', Courier, monospace;"><%= @verification_code %></span>
                                        </div>
                                        <p style="margin: 12px 0 0; font-size: 14px; color: #757686; font-family: 'Inter', sans-serif;">This code will expire in <%= @expiry_minutes %> minutes.</p>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 16px;">
                                        <a href="<%= @verify_url %>" style="background-color: #3649db; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 700; font-size: 15px; display: inline-block; box-shadow: 0 4px 12px rgba(54,73,219,0.25);">
                                            Open booking page
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center">
                                        <p style="margin: 0; font-size: 14px; color: #757686; font-family: 'Inter', sans-serif;">
                                            If you did not request this booking, you can ignore this email.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>